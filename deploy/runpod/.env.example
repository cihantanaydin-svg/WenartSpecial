# ArchRender RunPod deployment settings. Copy to deploy/runpod/.env and fill in.
# `python deploy/runpod/deploy.py up` reads this file. Secrets are sent to RunPod as account
# secrets and referenced from the pod env as {{ RUNPOD_SECRET_<name> }}; they never appear in the
# template.

# --- required -------------------------------------------------------------------------------
RUNPOD_API_KEY=                       # RunPod console → Settings → API Keys
ARCHRENDER_IMAGE=ghcr.io/your-org/archrender:0.1.0   # prefer @sha256:<digest> from the release
GHCR_USERNAME=                        # GitHub user that can read the package
GHCR_TOKEN=                           # classic PAT with read:packages
HF_TOKEN=                             # Hugging Face read token (accept gated terms, e.g. facebook/sam3)

# --- optional -------------------------------------------------------------------------------
ARCHRENDER_IMAGE_DIGEST=              # sha256:… (written into run manifests)
ARCHRENDER_ADMIN_TOKEN=               # empty → generated and printed once
ARCHRENDER_PROFILE=gpu80              # gpu48 | gpu80 | gpu96plus
DEPLOY_GPU_TYPES=                     # empty → profile default list (deploy/runpod/profiles.json)
DEPLOY_DATACENTERS=EU-RO-1,EU-CZ-1    # preference order; EU datacenters closest to Türkiye (ADR-S10)
DEPLOY_COMPLIANCE=                    # e.g. GDPR (filters the datacenter catalog)
DEPLOY_VOLUME_NAME=archrender-data
DEPLOY_VOLUME_GB=0                    # 0 → model budget + assets + caches, ×1.3, + project allowance
DEPLOY_VOLUME_TYPE=auto               # auto → HIGH_PERFORMANCE where offered, else STANDARD
DEPLOY_PROJECT_ALLOWANCE_GB=200
DEPLOY_CONTAINER_DISK_GB=100
DEPLOY_POD_NAME=archrender
DEPLOY_CLOUD=SECURE                   # client data is confidential; network volumes need SECURE
DEPLOY_MIN_CUDA_VERSION=13.0          # image is CUDA 13.0 (driver ≥ 580)
DEPLOY_ENABLE_SSH=false
DEPLOY_READY_TIMEOUT_MIN=60
ARCHRENDER_IDLE_STOP_MINUTES=0        # 0 = idle watchdog off
