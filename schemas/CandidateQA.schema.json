{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archrender.local/schemas/CandidateQA.schema.json",
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "family": {
          "enum": [
            "geometry",
            "brief",
            "artifact",
            "technical",
            "cross_view"
          ],
          "title": "Family",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "base_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Value"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "comparator": {
          "default": "<=",
          "enum": [
            "<=",
            ">=",
            "==",
            "bool"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "estimator": {
          "title": "Estimator",
          "type": "string"
        },
        "estimator_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "name",
        "family",
        "passed",
        "estimator"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "Exact identity of a model used to produce a fact or an image.",
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "name",
        "repo"
      ],
      "title": "ModelRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "view_id": {
      "title": "View Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "attempt": {
      "title": "Attempt",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "image_sha256": {
      "title": "Image Sha256",
      "type": "string"
    }
  },
  "required": [
    "view_id",
    "candidate_id",
    "attempt",
    "seed",
    "checks",
    "image_sha256"
  ],
  "title": "CandidateQA",
  "type": "object"
}
