{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archrender.local/schemas/RunManifest.schema.json",
  "$defs": {
    "Degradation": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "rung": {
          "title": "Rung",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "rung",
        "reason"
      ],
      "title": "Degradation",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "Exact identity of a model used to produce a fact or an image.",
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        },
        "mock": {
          "default": false,
          "title": "Mock",
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "name",
        "repo"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "StageTiming": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "cached": {
          "title": "Cached",
          "type": "boolean"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "vram_peak_mb": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vram Peak Mb"
        }
      },
      "required": [
        "stage",
        "key",
        "cached",
        "seconds"
      ],
      "title": "StageTiming",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "image_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Digest"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "profile": {
      "title": "Profile",
      "type": "string"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelRef"
      },
      "title": "Models",
      "type": "array"
    },
    "seeds": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "object"
    },
    "environment": {
      "additionalProperties": true,
      "title": "Environment",
      "type": "object"
    },
    "degradations": {
      "items": {
        "$ref": "#/$defs/Degradation"
      },
      "title": "Degradations",
      "type": "array"
    },
    "timings": {
      "items": {
        "$ref": "#/$defs/StageTiming"
      },
      "title": "Timings",
      "type": "array"
    },
    "uses_mocks": {
      "default": false,
      "title": "Uses Mocks",
      "type": "boolean"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "config_hash",
    "profile"
  ],
  "title": "RunManifest",
  "type": "object"
}
