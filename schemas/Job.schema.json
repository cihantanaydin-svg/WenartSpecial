{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archrender.local/schemas/Job.schema.json",
  "$defs": {
    "ErrorCode": {
      "enum": [
        "NOT_FOUND",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "CONFLICT",
        "VALIDATION",
        "RATE_LIMITED",
        "REQUEST_TIMEOUT",
        "INTERNAL",
        "INGEST_UNSUPPORTED_TYPE",
        "INGEST_UNSUPPORTED_NATIVE",
        "INGEST_TOO_LARGE",
        "INGEST_UNSAFE_ARCHIVE",
        "INGEST_CHECKSUM_MISMATCH",
        "INGEST_INCOMPLETE_UPLOAD",
        "INGEST_PARSER_FAILED",
        "INGEST_DWG_CONVERSION_FAILED",
        "INGEST_CORRUPT",
        "INGEST_ENCRYPTED",
        "INGEST_LIMIT_EXCEEDED",
        "INGEST_TOOL_MISSING",
        "PLAN_NO_PLAN_FOUND",
        "PLAN_SCALE_CONFLICT",
        "PLAN_INVALID",
        "SCENE_INVALID",
        "SCENE_NOT_WATERTIGHT",
        "BLENDER_NOT_FOUND",
        "BLENDER_FAILED",
        "RENDER_DEVICE_UNAVAILABLE",
        "MODEL_LICENSE_BLOCKED",
        "MODEL_NOT_DOWNLOADED",
        "MODEL_GATED_ACCESS",
        "MODEL_CHECKSUM_MISMATCH",
        "MODEL_LICENSE_MISMATCH",
        "CUDA_OOM_EXHAUSTED",
        "VRAM_BUDGET_EXCEEDED",
        "STAGE_TIMEOUT",
        "STAGE_FAILED",
        "GATE_REJECTED",
        "JOB_CANCELLED",
        "QA_DELIVERABLE_GUARD"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorInfo": {
      "description": "Serializable error payload (API responses, job records, QA report).",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "fix_hint": {
          "title": "Fix Hint",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "fix_hint"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "JobKind": {
      "enum": [
        "intake",
        "understand",
        "run",
        "bundle"
      ],
      "title": "JobKind",
      "type": "string"
    },
    "JobStatus": {
      "enum": [
        "queued",
        "running",
        "waiting_gate",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "JobStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/JobKind"
    },
    "queue": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "Queue",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/JobStatus"
    },
    "priority": {
      "default": 0,
      "title": "Priority",
      "type": "integer"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "attempts": {
      "default": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "max_attempts": {
      "default": 3,
      "title": "Max Attempts",
      "type": "integer"
    },
    "progress": {
      "default": 0.0,
      "title": "Progress",
      "type": "number"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "created_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    }
  },
  "required": [
    "id",
    "project_id",
    "kind",
    "queue",
    "status",
    "created_at"
  ],
  "title": "Job",
  "type": "object"
}
