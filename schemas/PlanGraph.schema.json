      "properties": {
        "value": {
          "enum": [
            "living",
            "kitchen",
            "dining",
            "bedroom",
            "bathroom",
            "wc",
            "entrance",
            "corridor",
            "balcony",
            "storage",
            "office",
            "meeting",
            "utility",
            "other"
