      },
      "required": [
        "center",
        "radius",
        "start_deg",
        "end_deg"
      ],
      "title": "Arc",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "title": "Value"
