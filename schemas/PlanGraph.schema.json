        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "minItems": 1,
          "title": "Provenance",
          "type": "array"
        },
        "status": {
          "default": "extracted",
          "enum": [
            "extracted",
            "corroborated",
