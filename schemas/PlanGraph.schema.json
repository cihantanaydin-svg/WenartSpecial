        "residual_m": {
          "default": 0.0,
          "title": "Residual M",
          "type": "number"
        },
        "method": {
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "matrix",
        "method"
      ],
      "title": "DocTransform",
      "type": "object"
