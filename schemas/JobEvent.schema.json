{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archrender.local/schemas/JobEvent.schema.json",
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "type": {
      "enum": [
        "status",
        "stage",
        "progress",
        "log",
        "gate",
        "result",
        "error"
      ],
      "title": "Type",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
  },
  "required": [
    "id",
    "job_id",
    "ts",
    "type"
  ],
  "title": "JobEvent",
  "type": "object"
}
